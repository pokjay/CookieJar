# ── Auth ─────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-secret

# Required. The shared family password used to log in.
AUTH_PASSWORD=replace-me-with-a-strong-password

# Required. Set to the URL the browser uses to reach the app.
# Local dev example (adjust port to match your docker-compose ports mapping):
NEXTAUTH_URL=http://localhost:3001
# On a hosted platform, use the public URL instead:
# NEXTAUTH_URL=https://your-app.onrender.com

# ── Data ─────────────────────────────────────────────────────────────────────
# USE_MOCK_DATA=true  → local seeded postgres (docker-compose.db.yml overlay spins it up)
# USE_MOCK_DATA=false → real prod DB from DATABASE_URL below, no local DB is started
USE_MOCK_DATA=true

# When USE_MOCK_DATA=true: uncomment to load the db overlay (starts postgres + db-seed).
# When USE_MOCK_DATA=false: leave commented — backend uses DATABASE_URL directly, no local DB.
# COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# Your prod/real DB connection string (used when USE_MOCK_DATA=false).
# The options=-csearch_path%3Dmoneyman param lets table names be used without schema prefix.
DATABASE_URL=postgresql://user:password@host:5432/dbname?options=-csearch_path%3Dmoneyman

# Separate test database for integration tests (used by pytest -m integration)
# Point this at a dedicated test DB, never at production.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/family_finance_test?options=-csearch_path%3Dmoneyman

# ── Scraper ───────────────────────────────────────────────────────────────────
# Shared secret between the Python backend and the Node.js scraper sidecar.
# Generate with: openssl rand -hex 32
# If unset, the sidecar accepts any request (not recommended for production).
SCRAPER_TOKEN=replace-me-with-a-random-token
# Per-account scrape HTTP timeout, in seconds (default 600). Raise it if accounts
# with many transactions time out — additionalTransactionInformation adds ~3s per
# transaction. Stay under 15 minutes (the stale-run guard bounds a whole sync).
# SCRAPER_HTTP_TIMEOUT=600

# ── Security note ─────────────────────────────────────────────────────────────
# The scraper feature sends your KeePass vault password and bank credentials
# over plain HTTP between the browser and the app. The real requirement:
# that traffic must never cross an untrusted network unencrypted. Pick the
# setup that matches your deployment (NEXTAUTH_URL above must always match
# the exact origin the browser uses — name and http/https scheme included):
#
# 1. LAN-only homelab behind an existing reverse proxy (nginx etc.):
#    Point your proxy at this host's port 3001 like any other service.
#    On a segmented network (trusted VLAN, nothing exposed to the internet)
#    running without certs is a reasonable trade-off — the residual risk is
#    local sniffing, mainly WPA2-PSK WiFi where any device that knows the
#    WiFi password can decrypt other clients' traffic (WPA3-only SSIDs are
#    immune — worth enabling on the trusted network if all devices support
#    it). To add real certs without exposing anything, issue a Let's Encrypt
#    wildcard via a DNS-01 challenge (certbot DNS plugin or acme.sh) — needs
#    only a DNS TXT record, no open ports, and one wildcard cert on the
#    proxy covers every homelab service at once. No purchased domain needed:
#    free subdomain services with a DNS API (DuckDNS, deSEC/dedyn.io) work
#    with the acme.sh dns_duckdns / dns_desec plugins.
#
# 2. Public domain, no existing proxy (Caddy, automatic Let's Encrypt cert):
#      cp Caddyfile.example Caddyfile   # then edit the domain inside
#      docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
#    Set NEXTAUTH_URL above to https://your-domain.example.com to match.
#    Requires a DNS A/AAAA record for the domain pointing at this host, and
#    ports 80/443 reachable from the internet (for the ACME challenge).
#    TLS is REQUIRED for any internet-reachable deployment.
#
# 3. Tailscale (remote access without exposing anything):
#    Install Tailscale on the host (or run it as a sidecar container), join
#    your tailnet, then enable "HTTPS Certificates" in the Tailscale admin
#    console and run: tailscale serve https / http://localhost:3001
#    Tailscale issues and renews the cert automatically; the app is reachable
#    only over your tailnet at https://<device-name>.<your-tailnet>.ts.net.
#    Set NEXTAUTH_URL above to that https://...ts.net address.

# ── KeePass vault ─────────────────────────────────────────────────────────────
# Bank credentials are stored in a dedicated KeePass database at:
#   /data/keepass/cookiejar_bank.kdbx  (inside the backend container)
# This path is backed by a named Docker volume 'keepass_data'.
# One-time setup: use the "Bank Accounts" tab in Settings → Init Vault.
# The .kdbx file can also be opened in KeePassXC desktop for manual management.
# Ensure the volume directory is not world-readable on the host (chmod 700).
